<?xml version="1.0"?>

<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="openarm_v1_mujoco"
>

  <!--
    Reuse OpenArm's actual v1 bimanual URDF.

    ros2_control is false by default in this upstream Xacro, which is
    important: we do NOT want OpenArmHW or GenericSystem here.
    We add our own MuJoCo hardware interface below.
  -->
  <xacro:include
    filename="$(find openarm_description)/assets/robot/openarm_v1.0/urdf/openarm_v10.urdf.xacro"
  />

  <xacro:arg name="mujoco_model" default="" />
  <xacro:arg name="pids_config_file" default="" />
  <xacro:arg name="headless" default="false" />

  <xacro:macro name="arm_joint" params="name">
    <joint name="${name}">
      <command_interface name="position" />

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </xacro:macro>

  <!--
    Gripper: same interface as the hardware (openarm_<side>_finger_joint1,
    opening 0-0.044 m). The MJCF has a second finger joint with its own
    actuator, coupled to the first by an equality constraint, so it mimics
    finger_joint1 to keep both actuators driving the same target.
  -->
  <xacro:macro name="gripper_joints" params="side">
    <joint name="openarm_${side}_finger_joint1">
      <command_interface name="position" />

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="openarm_${side}_finger_joint2">
      <param name="mimic">openarm_${side}_finger_joint1</param>
      <param name="multiplier">1</param>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </xacro:macro>

  <ros2_control name="OpenArmMujocoSystem" type="system">

    <!--
      Keep values on one line: Humble's ros2_control does not trim
      whitespace from the plugin name or parameter values.
    -->
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(arg mujoco_model)</param>
      <param name="pids_config_file">$(arg pids_config_file)</param>
      <param name="headless">$(arg headless)</param>
    </hardware>

    <!-- Left arm -->
    <xacro:arm_joint name="openarm_left_joint1" />
    <xacro:arm_joint name="openarm_left_joint2" />
    <xacro:arm_joint name="openarm_left_joint3" />
    <xacro:arm_joint name="openarm_left_joint4" />
    <xacro:arm_joint name="openarm_left_joint5" />
    <xacro:arm_joint name="openarm_left_joint6" />
    <xacro:arm_joint name="openarm_left_joint7" />
    <xacro:gripper_joints side="left" />

    <!-- Right arm -->
    <xacro:arm_joint name="openarm_right_joint1" />
    <xacro:arm_joint name="openarm_right_joint2" />
    <xacro:arm_joint name="openarm_right_joint3" />
    <xacro:arm_joint name="openarm_right_joint4" />
    <xacro:arm_joint name="openarm_right_joint5" />
    <xacro:arm_joint name="openarm_right_joint6" />
    <xacro:arm_joint name="openarm_right_joint7" />
    <xacro:gripper_joints side="right" />

  </ros2_control>

</robot>
